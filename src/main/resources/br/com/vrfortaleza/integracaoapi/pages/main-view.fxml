<?xml version="1.0" encoding="UTF-8"?>

<?import br.com.vrfortaleza.integracaoapi.pages.components.controllers.menu.MainMenu?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="101.0" prefWidth="614.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.vrfortaleza.integracaoapi.pages.MainController">
  <MainMenu fx:id="mainMenu" onContextMenuRequested="#loadConfigBody" />
    <Pane fx:id="contentPane" />
   <ButtonBar fx:id="buttonBar" prefHeight="10.0" prefWidth="200.0">
       <VBox.margin>
           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
       </VBox.margin>
     <buttons>
       <Button fx:id="homeButton" mnemonicParsing="false" onAction="#loadMainBody" text="Voltar" />
     </buttons>
   </ButtonBar>
   <Label fx:id="appLabel" text="Integração API 0.0.0" />
</VBox>
