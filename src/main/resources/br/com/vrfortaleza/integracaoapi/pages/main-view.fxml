<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import br.com.vrfortaleza.integracaoapi.pages.components.controllers.menu.MainMenu?>

<VBox alignment="CENTER" prefHeight="180.0" prefWidth="614.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.vrfortaleza.integracaoapi.pages.MainController">
  <MainMenu fx:id="mainMenu" onContextMenuRequested="#loadConfigBody" />
    <Pane fx:id="contentPane" />
   <ButtonBar fx:id="buttonBar" prefHeight="10.0" prefWidth="200.0">
       <VBox.margin>
           <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
       </VBox.margin>
     <buttons>
       <Button fx:id="homeButton" mnemonicParsing="false" onAction="#loadMainBody" text="Voltar" />
     </buttons>
   </ButtonBar>
</VBox>
